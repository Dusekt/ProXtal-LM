#!/bin/bash
#PBS -N proxtal_lm_train
#PBS -o logs/${PBS_JOBNAME}_${PBS_JOBID}.out
#PBS -e logs/${PBS_JOBNAME}_${PBS_JOBID}.err
#PBS -q gpu
#PBS -l select=1:ncpus=32:ngpus=8:mem=256gb
#PBS -l walltime=48:00:00
#PBS -M your.email@example.com
#PBS -m abe

# =============================================================================
# ProXtal-LM Multi-GPU Training Job
# =============================================================================
#
# Submit: qsub train_pbs.job
# Monitor: qstat -u $USER
# Cancel: qdel <job_id>
#
# =============================================================================

# ----------------------------- Configuration ---------------------------------

# Experiment settings
CONFIG="optimized"          # Config preset: default, small, large, optimized, cap
EXPERIMENT_NAME="multi_gpu_run"
MAX_EPOCHS=60
BATCH_SIZE=1                # Per-GPU batch size (total = batch_size * 8)
ACCUM_STEPS=64              # Gradient accumulation steps
LEARNING_RATE=2e-5

# Paths (adjust to your cluster setup)
PROJECT_DIR="/path/to/ProXtal-LM"          # <-- CHANGE THIS
DATA_DIR="/path/to/data"                 # <-- CHANGE THIS
SIF_PATH="/path/to/proxtal_lm_train.sif"    # <-- CHANGE THIS
CHECKPOINT_DIR="${PROJECT_DIR}/checkpoints/${EXPERIMENT_NAME}"

# Training mode: "ddp" or "fsdp"
TRAIN_MODE="ddp"

# Resume from checkpoint (optional)
RESUME_CHECKPOINT=""  # e.g., "${PROJECT_DIR}/checkpoints/prev_run/best_checkpoint.pt"

# ----------------------------- End Configuration -----------------------------

echo "============================================================================="
echo "Job ID: ${PBS_JOBID}"
echo "Job Name: ${PBS_JOBNAME}"
echo "Queue: ${PBS_QUEUE}"
echo "Nodes: ${PBS_NUM_NODES}"
echo "GPUs: ${PBS_NUM_GPUS}"
echo "Start Time: $(date)"
echo "============================================================================="

# Create directories
mkdir -p "${CHECKPOINT_DIR}"
mkdir -p "${PROJECT_DIR}/logs"

# Change to project directory
cd "${PROJECT_DIR}" || { echo "ERROR: Cannot cd to ${PROJECT_DIR}"; exit 1; }

# Set environment variables for optimal GPU training
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4
export NUMEXPR_NUM_THREADS=4

# Get node information
NODE_HOSTNAME=$(hostname)
NUM_GPUS=$(nvidia-smi -L | wc -l)

echo "Running on: ${NODE_HOSTNAME}"
echo "Available GPUs: ${NUM_GPUS}"

# Print GPU info
nvidia-smi --query-gpu=index,name,memory.total --format=csv,noheader

# Build training command
COMMON_ARGS="--config ${CONFIG} \
    --name ${EXPERIMENT_NAME} \
    --checkpoint-dir ${CHECKPOINT_DIR} \
    --max-epochs ${MAX_EPOCHS} \
    --batch-size ${BATCH_SIZE} \
    --accum-steps ${ACCUM_STEPS} \
    --learning-rate ${LEARNING_RATE}"

# Add resume if specified
if [ -n "${RESUME_CHECKPOINT}" ] && [ -f "${RESUME_CHECKPOINT}" ]; then
    COMMON_ARGS="${COMMON_ARGS} --resume ${RESUME_CHECKPOINT}"
fi

# Select training script based on mode
if [ "${TRAIN_MODE}" = "fsdp" ]; then
    TRAIN_SCRIPT="scripts/train_fsdp.py"
    TRAIN_CMD="torchrun --nproc_per_node=${NUM_GPUS} ${TRAIN_SCRIPT} ${COMMON_ARGS}"
else
    TRAIN_SCRIPT="scripts/train_multi.py"
    TRAIN_CMD="torchrun --nproc_per_node=${NUM_GPUS} ${TRAIN_SCRIPT} ${COMMON_ARGS}"
fi

echo "Training Mode: ${TRAIN_MODE}"
echo "Training Command: ${TRAIN_CMD}"
echo "-----------------------------------------------------------------------------"

# Run with Singularity
if [ -f "${SIF_PATH}" ]; then
    echo "Running with Singularity container: ${SIF_PATH}"

    # Bind paths and run
    singularity exec --nv \
        --bind "${PROJECT_DIR}:/workspace" \
        --bind "${DATA_DIR}:/data:ro" \
        --pwd /workspace \
        "${SIF_PATH}" \
        bash -c "${TRAIN_CMD}"

else
    echo "Running with native Python (no container)"

    # Activate virtual environment if needed
    # source /path/to/venv/bin/activate

    # Run directly
    ${TRAIN_CMD}
fi

EXIT_CODE=$?

echo "-----------------------------------------------------------------------------"
echo "End Time: $(date)"
echo "Exit Code: ${EXIT_CODE}"
echo "============================================================================="

# Copy logs to checkpoint directory
cp "${PBS_O_WORKDIR}/logs/${PBS_JOBNAME}_${PBS_JOBID}.out" "${CHECKPOINT_DIR}/"
cp "${PBS_O_WORKDIR}/logs/${PBS_JOBNAME}_${PBS_JOBID}.err" "${CHECKPOINT_DIR}/"

exit ${EXIT_CODE}
{
    "name": "small",
    "description": "Small model for quick testing and development",
    "model": {
        "emb_dim": 1152,
        "d_model": 128,
        "d_pair": 32,
        "n_seq_layers": 3,
        "n_blocks": 2,
        "tri_hidden": 16,
        "out_ch": 64,
        "n_heads": 8,
        "dropout": 0.1,
        "use_checkpoint": true,
        "n_recycles": 0,
        "max_rel_pos": 32,
        "num_space_groups": 231,
        "attention_window_size": 0,
        "n_hypotheses": 1
    },
    "data": {
        "train_path": "data/train_data_3d_cln.h5",
        "val_path": "data/valid_data_3d_cln.h5",
        "test_path": "data/test_data_3d_cln.h5",
        "num_bins": 64,
        "smooth_sigma": 0.8,
        "pad_multiple": 8,
        "batch_size": 8,
        "num_workers": 4,
        "pin_memory": true
    },
    "training": {
        "learning_rate": 2e-5,
        "weight_decay": 1e-4,
        "grad_clip": 1.0,
        "accum_steps": 32,
        "max_epochs": 60,
        "scheduler_type": "none",
        "scheduler_factor": 0.8,
        "scheduler_patience": 5,
        "scheduler_min_lr": 1e-7,
        "early_stop_patience": 10,
        "use_amp": true,
        "use_compile": false,
        "matching_mode": "none",
        "crystal_og_weight": 0.0,
        "diversity_weight": 0.0,
        "crystal_contact_weight": 0.0,
        "contact_threshold": 0.1,
        "contact_emphasis": 1.0
    }
}
